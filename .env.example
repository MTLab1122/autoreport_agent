# ==============================================================================
# AI & TECH INTELLIGENCE BRIEFING AGENT CONFIGURATION (HARDENED ZERO-TRUST)
# ==============================================================================

# 1. Gemini API Key (Required for live sweep and synthesis)
# Obtain a free or paid API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Resend API Key (Optional HTTP API delivery)
RESEND_API_KEY=re_your_api_key_here

# 3. Gmail SMTP Configuration (Direct delivery to any recipient using App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# 4. Email Recipients (comma-separated or distinct variables)
OWNER_EMAIL=your_email@gmail.com
FORWARD_EMAIL=partner@example.com
RECIPIENT_EMAIL=your_email@gmail.com,partner@example.com

# 5. Schedule & Timezone Configuration
SCHEDULE_TIME=07:00
TIMEZONE=Asia/Karachi
CATCH_UP_MAX_DAYS=7

# 6. Gemini Model (Optional, defaults to gemini-3.8-flash, with automatic fallback)
GEMINI_MODEL=gemini-3.8-flash

# 7. Zero-Trust Security Settings (Optional)
# Secret for HMAC-SHA256 signature verification on /webhook endpoint
WEBHOOK_SECRET=your_random_webhook_secret_here

# Confirmation token for Human-in-the-Loop approval of bulk dispatches
HITL_CONFIRMATION_TOKEN=
AUTO_APPROVE_DISPATCH=true
